# 나이스 교육정보 개방 포털(https://open.neis.go.kr)에서 발급한 인증키입니다.
# 이 파일은 예시입니다. 키는 아래 파일을 만들어 그 안에만 적으세요.
#
#   gyo624_FrontEnd/.env.local
#
# 파일 내용:
#   NEIS_API_KEY=발급받은인증키
#
# 키는 개발 서버만 읽고, 브라우저 화면이나 저장소에는 넣지 않습니다.
# 저장한 뒤 설정의 "키 다시 확인"을 누르면 됩니다. 서버를 다시 켤 필요는 없습니다.
NEIS_API_KEY=

# 배포된 화면이 나이스를 부를 주소입니다. 키는 이 주소의 서버에만 둡니다.
# 로컬 개발 서버는 이 값이 없어도 /api/neis 로 연결합니다.
# VITE_NEIS_ORIGIN=https://gyo624-neis.example.workers.dev

# 교과세특 AI. 키는 개발 서버와 배포 워커만 읽습니다. 브라우저 화면에는 넣지 않습니다.
# AI_PROVIDER 는 openai, gemini, anthropic 중 하나입니다.
# GPT는 OPENAI_API_KEY만 있어도 연결됩니다. AI_API_KEY가 있으면 그 키를 먼저 씁니다.
# AI_MODEL 또는 OPENAI_MODEL 을 비우면 gpt-6.1-terra를 사용합니다.
# FIREBASE_WEB_API_KEY 는 아래 VITE_FIREBASE_API_KEY 와 같은 웹 API 키입니다.
# 배포 화면은 VITE_SETEK_ORIGIN 의 워커로 생성 요청을 보냅니다.
# AI_PROVIDER=openai
# AI_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=
# OPENAI_MODEL=
# FIREBASE_WEB_API_KEY=
# SETEK_RATE_LIMIT=8
# SETEK_RATE_WINDOW_MS=600000
# VITE_SETEK_ORIGIN=https://gyo624-setek.example.workers.dev

# Firebase 웹 앱 설정입니다. 이 값들은 빌드 결과에 포함되는 공개 식별자입니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gyo624.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gyo624
VITE_FIREBASE_STORAGE_BUCKET=gyo624.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=947321877786
VITE_FIREBASE_APP_ID=
