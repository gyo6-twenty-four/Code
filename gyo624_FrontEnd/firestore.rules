rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'ADMIN'
        && get(userPath(request.auth.uid)).data.status == 'ACTIVE';
    }
    function blankSchool(data) {
      return !data.keys().hasAny(['schoolCode']) || data.schoolCode == '';
    }
    function storedSchool(data) {
      return data.keys().hasAny(['schoolCode']) && data.schoolCode is string && data.schoolCode != ''
        ? data.schoolCode
        : '';
    }
    function keepsPrivileges() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('classIds', []) == resource.data.get('classIds', [])
        && request.resource.data.get('recordTypes', []) == resource.data.get('recordTypes', []);
    }
    function sameList(stored, next) {
      return next is list && (stored == next || stored == null);
    }
    function optionalTeaching(data) {
      return (!data.keys().hasAny(['homeroomClassId']) || (data.homeroomClassId is string && data.homeroomClassId.size() <= 240))
        && (!data.keys().hasAny(['subjectIds']) || (data.subjectIds is list && data.subjectIds.size() <= 30))
        && (!data.keys().hasAny(['teachingClassIds']) || (data.teachingClassIds is list && data.teachingClassIds.size() <= 60));
    }

    match /schools/{schoolCode} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.auth.uid == request.resource.data.adminUid
        && request.resource.data.schoolCode == schoolCode
        && request.resource.data.schoolCode is string
        && request.resource.data.schoolCode.matches('^[A-Z0-9]{7,10}$');
      allow update, delete: if false;
    }

    match /meta/school {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'schoolCode', 'officeCode', 'officeName', 'kind'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300
        && request.resource.data.schoolCode is string
        && request.resource.data.schoolCode.matches('^[A-Z0-9]{7,10}$')
        && request.resource.data.officeCode is string
        && request.resource.data.officeCode.size() > 0
        && request.resource.data.officeCode.size() <= 10
        && request.resource.data.officeName is string
        && request.resource.data.officeName.size() <= 180
        && request.resource.data.kind is string
        && request.resource.data.kind.size() <= 120;
      allow delete: if false;
    }

    match /meta/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/bootstrap)
        && request.resource.data.adminUid == request.auth.uid
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'ADMIN';
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.schoolCode is string
        && (
          (
            request.resource.data.role == 'ADMIN'
            && request.resource.data.schoolCode == ''
            && !request.resource.data.keys().hasAny(['invitationId'])
          )
          || (
            request.resource.data.role in ['TEACHER', 'ADMIN']
            && request.resource.data.invitationId is string
            && exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.accepted == false
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role
            && sameList(get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.get('classIds', null), request.resource.data.classIds)
            && sameList(get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.get('recordTypes', null), request.resource.data.recordTypes)
            && request.resource.data.schoolCode == storedSchool(get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data)
          )
        );
      allow update: if signedIn() && (
        (
          isAdmin()
          && (
            (
              resource.data.keys().hasAny(['schoolCode'])
              && request.resource.data.keys().hasAny(['schoolCode'])
              && request.resource.data.schoolCode == resource.data.schoolCode
            )
            || (
              blankSchool(resource.data)
              && blankSchool(request.resource.data)
            )
          )
          && !(request.auth.uid == uid && resource.data.role == 'ADMIN' && request.resource.data.role != 'ADMIN')
          && !(request.auth.uid == uid && resource.data.status == 'ACTIVE' && request.resource.data.status != 'ACTIVE')
        )
        || (
          request.auth.uid == uid
          && resource.data.role == 'TEACHER'
          && resource.data.status == 'ACTIVE'
          && keepsPrivileges()
          && request.resource.data.schoolCode is string
          && request.resource.data.schoolCode.matches('^[A-Z0-9]{7,10}$')
          && request.resource.data.schoolName is string
          && request.resource.data.schoolName.size() > 0
          && request.resource.data.schoolName.size() <= 300
          && request.resource.data.officeCode is string
          && request.resource.data.officeCode.size() > 0
          && request.resource.data.officeCode.size() <= 10
          && optionalTeaching(request.resource.data)
        )
        || (
          request.auth.uid == uid
          && keepsPrivileges()
          && (
            (
              resource.data.keys().hasAny(['schoolCode'])
              && request.resource.data.keys().hasAny(['schoolCode'])
              && request.resource.data.schoolCode == resource.data.schoolCode
            )
            || (
              blankSchool(resource.data)
              && blankSchool(request.resource.data)
            )
          )
          && optionalTeaching(request.resource.data)
        )
      );
      allow delete: if false;
    }

    match /invitations/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.accepted == false
        && request.resource.data.role in ['TEACHER', 'ADMIN']
        && (
          request.resource.data.role == 'ADMIN' && storedSchool(request.resource.data) == ''
          || request.resource.data.role == 'TEACHER'
            && request.resource.data.schoolCode is string
            && request.resource.data.schoolCode.matches('^[A-Z0-9]{7,10}$')
        );
      allow update: if isAdmin();
      allow update: if signedIn()
        && resource.data.accepted == false
        && request.resource.data.accepted == true
        && request.resource.data.email == resource.data.email
        && request.auth.token.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted', 'acceptedAt']);
      allow delete: if isAdmin();
    }

    function setekText(value, maxBytes) {
      return value is string && value.size() <= maxBytes;
    }

    match /meta/setekPolicy {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['unit', 'elementary', 'middle', 'high', 'note', 'updatedAt', 'updatedBy'])
        && request.resource.data.unit in ['characters', 'bytes']
        && request.resource.data.elementary is int
        && request.resource.data.middle is int
        && request.resource.data.high is int
        && request.resource.data.elementary >= 0
        && request.resource.data.elementary <= 6000
        && request.resource.data.middle >= 0
        && request.resource.data.middle <= 6000
        && request.resource.data.high >= 0
        && request.resource.data.high <= 6000
        && setekText(request.resource.data.note, 1200)
        && setekText(request.resource.data.updatedAt, 40)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /setekCurricula/{curriculumId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && curriculumId != '2015'
        && curriculumId != '2022'
        && curriculumId.matches('^y[0-9]{4}-[a-f0-9]{8}$')
        && request.resource.data.keys().hasOnly(['name', 'year', 'createdBy', 'createdAt', 'updatedAt'])
        && setekText(request.resource.data.name, 300)
        && request.resource.data.name.size() > 0
        && request.resource.data.year is int
        && request.resource.data.year >= 1990
        && request.resource.data.year <= 2100
        && request.resource.data.createdBy == request.auth.uid
        && setekText(request.resource.data.createdAt, 40)
        && setekText(request.resource.data.updatedAt, 40);
      allow delete: if isAdmin();
    }

    match /setekSubjects/{subjectId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['curriculumId', 'schoolLevel', 'name', 'subjectType', 'createdBy', 'createdAt', 'updatedAt'])
        && setekText(request.resource.data.curriculumId, 80)
        && request.resource.data.curriculumId.size() > 0
        && request.resource.data.schoolLevel in ['elementary', 'middle', 'high']
        && setekText(request.resource.data.name, 300)
        && request.resource.data.name.size() > 0
        && setekText(request.resource.data.subjectType, 40)
        && request.resource.data.createdBy == request.auth.uid
        && setekText(request.resource.data.createdAt, 40)
        && setekText(request.resource.data.updatedAt, 40);
      allow delete: if isAdmin();
    }

    match /setekStandards/{standardId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['subjectId', 'code', 'category', 'content', 'source', 'sourceUrl', 'createdBy', 'createdAt', 'updatedAt'])
        && setekText(request.resource.data.subjectId, 80)
        && request.resource.data.subjectId.size() > 0
        && setekText(request.resource.data.code, 160)
        && request.resource.data.code.size() > 0
        && setekText(request.resource.data.category, 300)
        && setekText(request.resource.data.content, 12000)
        && request.resource.data.content.size() > 0
        && setekText(request.resource.data.source, 800)
        && request.resource.data.source.size() > 0
        && setekText(request.resource.data.sourceUrl, 500)
        && request.resource.data.createdBy == request.auth.uid
        && setekText(request.resource.data.createdAt, 40)
        && setekText(request.resource.data.updatedAt, 40);
      allow delete: if isAdmin();
    }

    match /users/{uid}/setekDrafts/{draftId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['classId', 'studentId', 'curriculumId', 'curriculumName', 'curriculumYear', 'schoolLevel', 'subjectId', 'subjectName', 'subjectType', 'selectedStandards', 'lesson', 'student', 'growth', 'traits', 'traitNote', 'teacherRequest', 'lengthMode', 'customLength', 'unit', 'targetLength', 'generatedContent', 'editedContent', 'createdAt', 'updatedAt'])
        && setekText(request.resource.data.classId, 200)
        && setekText(request.resource.data.studentId, 200)
        && request.resource.data.schoolLevel in ['elementary', 'middle', 'high']
        && request.resource.data.unit in ['characters', 'bytes']
        && request.resource.data.targetLength is int
        && request.resource.data.targetLength >= 50
        && request.resource.data.targetLength <= 6000
        && request.resource.data.curriculumYear is int
        && request.resource.data.selectedStandards is list
        && request.resource.data.selectedStandards.size() <= 12
        && request.resource.data.lesson is map
        && request.resource.data.lesson.size() <= 8
        && request.resource.data.student is map
        && request.resource.data.student.size() <= 8
        && request.resource.data.growth is map
        && request.resource.data.growth.size() <= 6
        && request.resource.data.traits is list
        && request.resource.data.traits.size() <= 8
        && setekText(request.resource.data.generatedContent, 30000)
        && setekText(request.resource.data.editedContent, 30000)
        && setekText(request.resource.data.teacherRequest, 12000)
        && setekText(request.resource.data.traitNote, 24000)
        && setekText(request.resource.data.subjectName, 300)
        && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
    }

    function teacherSchoolCode() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'ACTIVE'
        && get(userPath(request.auth.uid)).data.keys().hasAny(['schoolCode'])
        ? get(userPath(request.auth.uid)).data.schoolCode
        : '';
    }
    function validClassRecord(data) {
      return data.keys().hasOnly(['schoolCode', 'schoolName', 'officeCode', 'officeName', 'kind', 'schoolYear', 'grade', 'classNumber', 'name'])
        && data.schoolCode is string
        && data.schoolCode.matches('^[A-Z0-9]{7,10}$')
        && data.schoolName is string
        && data.schoolName.size() > 0
        && data.schoolName.size() <= 300
        && data.officeCode is string
        && data.officeCode.size() <= 10
        && data.officeName is string
        && data.officeName.size() <= 180
        && data.kind is string
        && data.kind.size() <= 120
        && data.schoolYear is int
        && data.schoolYear >= 2000
        && data.schoolYear <= 2100
        && data.grade is int
        && data.grade >= 1
        && data.grade <= 6
        && data.classNumber is int
        && data.classNumber >= 1
        && data.classNumber <= 99
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40;
    }
    function validStudentRecord(data) {
      return data.keys().hasOnly(['schoolCode', 'schoolYear', 'classId', 'grade', 'classNumber', 'number', 'name', 'pseudonymId'])
        && data.schoolCode is string
        && data.schoolCode.matches('^[A-Z0-9]{7,10}$')
        && data.schoolYear is int
        && data.schoolYear >= 2000
        && data.schoolYear <= 2100
        && data.classId is string
        && data.classId.size() > 0
        && data.classId.size() <= 120
        && data.grade is int
        && data.grade >= 1
        && data.grade <= 6
        && data.classNumber is int
        && data.classNumber >= 1
        && data.classNumber <= 99
        && data.number is int
        && data.number >= 1
        && data.number <= 999
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.pseudonymId is string
        && data.pseudonymId.size() <= 40;
    }
    function canWriteSchool(code) {
      return isAdmin() || teacherSchoolCode() == code;
    }

    match /classes/{classId} {
      allow get: if signedIn() && (isAdmin() || resource.data.schoolCode == teacherSchoolCode());
      allow list: if signedIn() && (isAdmin() || resource.data.schoolCode == teacherSchoolCode());
      allow create: if signedIn() && validClassRecord(request.resource.data) && canWriteSchool(request.resource.data.schoolCode);
      allow update: if signedIn()
        && validClassRecord(request.resource.data)
        && request.resource.data.schoolCode == resource.data.schoolCode
        && canWriteSchool(resource.data.schoolCode);
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow get: if signedIn() && (isAdmin() || resource.data.schoolCode == teacherSchoolCode());
      allow list: if signedIn() && (isAdmin() || resource.data.schoolCode == teacherSchoolCode());
      allow create: if signedIn() && validStudentRecord(request.resource.data) && canWriteSchool(request.resource.data.schoolCode);
      allow update: if signedIn()
        && validStudentRecord(request.resource.data)
        && request.resource.data.schoolCode == resource.data.schoolCode
        && request.resource.data.classId == resource.data.classId
        && canWriteSchool(resource.data.schoolCode);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
