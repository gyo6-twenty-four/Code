# Copy to .env.local. Provider secrets belong only to this service.
AI_PROVIDER=openai
OPENAI_API_KEY=
# AI_API_KEY=
# AI_MODEL=
# OPENAI_MODEL=

# Same Firebase project as the frontend login. Not a service-account private key.
FIREBASE_WEB_API_KEY=

SETEK_RATE_LIMIT=8
SETEK_RATE_WINDOW_MS=600000
# Used only when a browser calls FastAPI directly, without the Vite proxy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
