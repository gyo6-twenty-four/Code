# 실제 값은 이 파일에 넣지 말고 배포 환경의 비밀 저장소에 등록하세요.
# JWT_SECRET은 최소 32바이트의 무작위 값이어야 합니다.
# 생성 예시: openssl rand -base64 48
JWT_SECRET=

# 최초 설치 때만 true로 켜고 관리자 생성 직후 다시 false로 바꾸세요.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=최초 관리자
BOOTSTRAP_ADMIN_SCHOOL_CODE=DEFAULT

DB_URL=jdbc:postgresql://localhost:5432/education24
DB_USERNAME=
DB_PASSWORD=

# AI 키는 VITE_ 접두사가 붙은 클라이언트 환경변수에 저장하지 마세요.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
